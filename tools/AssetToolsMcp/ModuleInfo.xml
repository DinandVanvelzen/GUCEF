<?xml version="1.0" encoding="ISO-8859-1" ?>
<ModuleInfoEntry>
    <Module Name="AssetToolsMcp" Platform="All" Type="Executable" Tags="tools" >
        <ModuleMetaData>
            <License>APACHEv2</License>
            <SemVer>0.1.0.0</SemVer>
            <DescriptionHeadline>The asset tools as an MCP server over stdio, on a local asset store service</DescriptionHeadline>
            <DescriptionDetails>Hosts the asset tool set of gucefASSETSTORE (CAssetToolSet) on the in-process asset store service (CLocalAssetStoreService) with the converter pipeline as its converter hook (AssetStoreConverterHook), for an MCP client that starts it as a child process. Reads one settings file; no logic of its own beyond hosting.</DescriptionDetails>
            <Authors>
                <Author>Dinand Vanvelzen</Author>
            </Authors>
            <Maintainers>
                <Maintainer>Dinand Vanvelzen</Maintainer>
            </Maintainers>
        </ModuleMetaData>
