<ModuleInfoEntry>
    <Module Name="AssetViewer" Type="Executable" Platform="mswin;linux" Tags="tools">
        <ModuleMetaData>
            <License>Apache 2.0</License>
            <SemVer>0.1.0.0</SemVer>
            <DescriptionHeadline>Asset viewer: content browser and model, texture, material and scene views over the VFS, with headless contact sheet capture</DescriptionHeadline>
            <DescriptionDetails>Mounts folders, zip and libarchive archives and Unity packages (also nested) in the VFS, browses them and shows Ogre meshes, scenes and textures, and every source model that the Assimp codec of Ogre reads. With --capture it renders each listed asset from fixed views into one PNG contact sheet and exits, without a window on the screen when there is no display.</DescriptionDetails>
            <Authors>
                <Author>Dinand Vanvelzen</Author>
            </Authors>
            <Maintainers>
                <Maintainer>Dinand Vanvelzen</Maintainer>
            </Maintainers>
        </ModuleMetaData>
        <Dependencies>
            <Dependency Name="gucefHeaders" />
            <Dependency Name="gucefMT" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="gucefIMAGE" />
            <Dependency Name="gucefINPUT" />
            <Dependency Name="gucefGUI" />
            <Dependency Name="AssetViewerLib" />
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="gucefMT" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="gucefIMAGE" />
            <Dependency Name="gucefINPUT" />
            <Dependency Name="gucefGUI" />
            <Dependency Name="AssetViewerLib" />
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="ASSETVIEWER_BUILD_MODULE" />
        </Preprocessor>
        <Compiler MinCppStandard="14" />
        <RuntimeDependencies>
            <RuntimeDependency Name="dstorepluginJSONPARSER" />
            <RuntimeDependency Name="codecspluginZLIB" />
            <RuntimeDependency Name="vfspluginLIBARCHIVE" />
            <RuntimeDependency Name="vfspluginUNITYPACKAGE" />
            <RuntimeDependency Name="fontpluginFREETYPE" />
            <RuntimeDependency Name="imgpluginFreeImage" />
            <RuntimeDependency Name="pluginglueOGRE" />
            <RuntimeDependency Name="guidriverOgre" />
            <RuntimeDependency Name="guidriverImGuiOgre" />
            <RuntimeDependency Name="OgrePlugin_GucefVFS" />
            <RuntimeDependency Name="OgreCodec_GucefIMAGE" />
            <RuntimeDependency Name="OgreCodec_Assimp" />
            <RuntimeDependency Name="OgrePlugin_DotScene" />
            <RuntimeDependency Name="OgreRenderSystem_GL3Plus" />
            <RuntimeDependency Name="OgreRenderSystem_Vulkan" />
            <RuntimeDependency Name="OgrePlugin_GLSLangProgramManager" />
        </RuntimeDependencies>
    </Module>
    <Module Platform="linux">
