{
    "contract": "gucef.assetstore.files",
    "version": "1.0",
    "doc": "The files of the asset store service: stats, listings and uploads as generic calls, blocks of files and uploads as bytes",
    "types": [
        {
            "name": "CallRequest",
            "doc": "One call of the asset store service: the operation of CAssetServiceOperations, the command id of a mutation and the arguments by parameter name",
            "fields": [
                { "number": 1, "name": "operation", "type": "string" },
                { "number": 2, "name": "commandId", "type": "string" },
                { "number": 3, "name": "args", "type": "datanode" }
            ]
        },
        {
            "name": "CallAnswer",
            "doc": "The answer of a call: the status name, a message for people, the result record and the event sequence after the call",
            "fields": [
                { "number": 1, "name": "status", "type": "string" },
                { "number": 2, "name": "message", "type": "string" },
                { "number": 3, "name": "result", "type": "datanode" },
                { "number": 4, "name": "eventSeq", "type": "uint64" },
                { "number": 5, "name": "replayed", "type": "bool" }
            ]
        },
        {
            "name": "ReadBlockRequest",
            "doc": "At most one block (262144 bytes) of a file of the service from an offset",
            "fields": [
                { "number": 1, "name": "path", "type": "string" },
                { "number": 2, "name": "offset", "type": "uint64" },
                { "number": 3, "name": "length", "type": "uint32" }
            ]
        },
        {
            "name": "Block",
            "doc": "The bytes read, with the size of the file",
            "fields": [
                { "number": 1, "name": "status", "type": "string" },
                { "number": 2, "name": "message", "type": "string" },
                { "number": 3, "name": "fileSize", "type": "uint64" },
                { "number": 4, "name": "endOfFile", "type": "bool" },
                { "number": 5, "name": "data", "type": "bytes" },
                { "number": 6, "name": "offset", "type": "uint64" }
            ]
        },
        {
            "name": "WriteBlockRequest",
            "doc": "Bytes of a file of an upload at an offset",
            "fields": [
                { "number": 1, "name": "uploadId", "type": "string" },
                { "number": 2, "name": "path", "type": "string" },
                { "number": 3, "name": "offset", "type": "uint64" },
                { "number": 4, "name": "data", "type": "bytes" }
            ]
        }
    ],
    "services": [
        {
            "name": "Files",
            "number": 1,
            "methods": [
                { "number": 1, "name": "Query", "kind": "unary", "request": "CallRequest", "response": "CallAnswer", "flags": [ "idempotent" ], "deadlineMs": 60000 },
                { "number": 2, "name": "Command", "kind": "unary", "request": "CallRequest", "response": "CallAnswer", "deadlineMs": 600000 },
                { "number": 3, "name": "ReadBlock", "kind": "unary", "request": "ReadBlockRequest", "response": "Block", "flags": [ "idempotent" ], "deadlineMs": 60000 },
                { "number": 4, "name": "WriteBlock", "kind": "unary", "request": "WriteBlockRequest", "response": "CallAnswer", "deadlineMs": 60000 }
            ]
        }
    ]
}
