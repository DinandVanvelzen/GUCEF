<ModuleInfoEntries>
<ModuleInfoEntry>
    <Module Name="gucefCORE" Type="SharedLibrary" Platform="All" Tags="platform">
		<ModuleMetaData>
			<License>APACHEv2</License>
			<SemVer>0.1.0.0</SemVer>
			<DescriptionHeadline>GUCEF module providing O/S abstraction and generic solutions</DescriptionHeadline>
			<DescriptionDetails></DescriptionDetails>
			<Authors>
				<Author>Dinand Vanvelzen</Author>
			</Authors>
			<Maintainers>
				<Maintainer>Dinand Vanvelzen</Maintainer>
			</Maintainers>
		</ModuleMetaData>
        <Dependencies>
            <Dependency Name="gucefMT" />
        </Dependencies>
        <Linker>
            <Dependency Name="gucefMT" Scope="public" />
        </Linker>
        <Preprocessor>
            <Define String="GUCEF_CORE_BUILD_MODULE" />
        </Preprocessor>
        <!-- headers in src are private to gucefCORE: they are not include search paths for gucefCORE nor its dependents -->
        <Includes Source="ExcludedFromSearchPaths">
            <Include Path="src" />
        </Includes>
    </Module>
    <Module Platform="mswin">
        <Linker>
            <Dependency Name="Ws2_32.lib" Scope="private" />
			<Dependency Name="PowrProf.lib" Scope="private" />
			<Dependency Name="Shlwapi.lib" Scope="private" />
			<Dependency Name="Bcrypt.lib" Scope="private" />
        </Linker>
    </Module>  
    <Module Platform="linux">
        <Linker>
            <Dependency Name="dl" Scope="private" />
            <Dependency Name="rt" Scope="private" />
            <Dependency Name="X11" Scope="private" />
        </Linker>
    </Module>
    <Module Platform="android">
        <Linker>
            <Dependency Name="dl" Scope="private" />
        </Linker>
    </Module>
    <Module Platform="osx">
        <Linker>
            <!-- FSEvents, which the file system watcher is made with -->
            <Dependency Name="-Wl,-framework,CoreServices" Scope="private" />
            <Dependency Name="-Wl,-framework,CoreFoundation" Scope="private" />
            <!-- the pasteboard behind the clipboard functions -->
            <Dependency Name="-Wl,-framework,ApplicationServices" Scope="private" />
            <!-- the security session, which tells whether there is a desktop to open a terminal window in -->
            <Dependency Name="-Wl,-framework,Security" Scope="private" />
        </Linker>
    </Module>
</ModuleInfoEntry>
