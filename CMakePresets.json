        { "name": "GUCEF_tag_platform-Windows-Release",          "displayName": "GUCEF_tag_platform | Release",          "configurePreset": "GUCEF_tag_platform-Windows",           "configuration": "Release" },
        { "name": "GUCEF_tag_services-Windows-Debug",            "displayName": "GUCEF_tag_services | Debug",            "configurePreset": "GUCEF_tag_services-Windows",           "configuration": "Debug"   },
        { "name": "GUCEF_tag_services-Windows-Release",          "displayName": "GUCEF_tag_services | Release",          "configurePreset": "GUCEF_tag_services-Windows",           "configuration": "Release" },
        { "name": "GUCEF_tag_tools-Windows-Debug",               "displayName": "GUCEF_tag_tools | Debug",               "configurePreset": "GUCEF_tag_tools-Windows",              "configuration": "Debug"   },
        { "name": "GUCEF_tag_tools-Windows-Release",             "displayName": "GUCEF_tag_tools | Release",             "configurePreset": "GUCEF_tag_tools-Windows",              "configuration": "Release" },

        { "name": "GUCEF_exe_gucefCORE_TestApp-Linux-Debug",     "displayName": "GUCEF_exe_gucefCORE_TestApp | Debug",   "configurePreset": "GUCEF_exe_gucefCORE_TestApp-Linux",   "configuration": "Debug"   },
        { "name": "GUCEF_exe_gucefCORE_TestApp-Linux-Release",   "displayName": "GUCEF_exe_gucefCORE_TestApp | Release", "configurePreset": "GUCEF_exe_gucefCORE_TestApp-Linux",   "configuration": "Release" },
        { "name": "GUCEF_tag_test-Linux-Debug",                  "displayName": "GUCEF_tag_test | Debug",                "configurePreset": "GUCEF_tag_test-Linux",                 "configuration": "Debug"   },
        { "name": "GUCEF_tag_test-Linux-Release",                "displayName": "GUCEF_tag_test | Release",              "configurePreset": "GUCEF_tag_test-Linux",                 "configuration": "Release" },
        { "name": "GUCEF_tag_platform-Linux-Debug",              "displayName": "GUCEF_tag_platform | Debug",            "configurePreset": "GUCEF_tag_platform-Linux",             "configuration": "Debug"   },
        { "name": "GUCEF_tag_platform-Linux-Release",            "displayName": "GUCEF_tag_platform | Release",          "configurePreset": "GUCEF_tag_platform-Linux",             "configuration": "Release" },
        { "name": "GUCEF_tag_services-Linux-Debug",              "displayName": "GUCEF_tag_services | Debug",            "configurePreset": "GUCEF_tag_services-Linux",             "configuration": "Debug"   },
        { "name": "GUCEF_tag_services-Linux-Release",            "displayName": "GUCEF_tag_services | Release",          "configurePreset": "GUCEF_tag_services-Linux",             "configuration": "Release" },
        { "name": "GUCEF_tag_tools-Linux-Debug",                 "displayName": "GUCEF_tag_tools | Debug",               "configurePreset": "GUCEF_tag_tools-Linux",                "configuration": "Debug"   },
        { "name": "GUCEF_tag_tools-Linux-Release",               "displayName": "GUCEF_tag_tools | Release",             "configurePreset": "GUCEF_tag_tools-Linux",                "configuration": "Release" }
