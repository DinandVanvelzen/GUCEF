        {
            "name": "GUCEF_tag_tools-Linux",
            "displayName": "GUCEF_tag_tools",
            "inherits": [ "_target-GUCEF_tag_tools", "_comp-Ninja-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_tools",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" }
        },

        // macOS defaults (Ninja x64)
        {
            "name": "GUCEF_exe_gucefCORE_TestApp-Darwin",
            "displayName": "GUCEF_exe_gucefCORE_TestApp",
            "inherits": [ "_target-GUCEF_exe_gucefCORE_TestApp", "_comp-Ninja-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_exe_gucefCORE_TestApp",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
