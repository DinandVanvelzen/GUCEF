{
    "version": 3,
    "cmakeMinimumRequired": { "major": 3, "minor": 20, "patch": 0 },

    "configurePresets": [

        // ---------------------------------------------------------------
        // Hidden _comp-* presets: compiler/toolchain building blocks.
        // Users reference these in CMakeUserPresets.json via "inherits".
        // ---------------------------------------------------------------
        {
            "name": "_comp-VS2026-x64",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "_comp-ClangCL-x64",
            "hidden": true,
            "generator": "Visual Studio 18 2026",
            "architecture": "x64",
            "toolset": "ClangCL",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "_comp-Ninja-x64",
            "hidden": true,
            "generator": "Ninja",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5"
            }
        },
        {
            "name": "_comp-Emscripten",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/projects/CMake/Emscripten.toolchain.cmake",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "PLATFORM": "wasm"
            }
        },
        {
            "name": "_comp-Android-arm64",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/projects/CMake/Android.cmake",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "ANDROID_ABI": "arm64-v8a",
                "ANDROID_PLATFORM": "android-21"
            }
        },
        {
            "name": "_comp-Android-arm32",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/projects/CMake/Android.cmake",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "ANDROID_ABI": "armeabi-v7a",
                "ANDROID_PLATFORM": "android-21"
            }
        },
        {
            "name": "_comp-Android-x86_64",
            "hidden": true,
            "generator": "Ninja",
            "toolchainFile": "${sourceDir}/projects/CMake/Android.cmake",
            "cacheVariables": {
                "BUILD_SHARED_LIBS": "ON",
                "CMAKE_POLICY_VERSION_MINIMUM": "3.5",
                "ANDROID_ABI": "x86_64",
                "ANDROID_PLATFORM": "android-21"
            }
        },

        // ---------------------------------------------------------------
        // Hidden _target-* presets: build-target building blocks.
        // Users reference these in CMakeUserPresets.json via "inherits".
        // ---------------------------------------------------------------
        { "name": "_target-GUCEF_exe_gucefCORE_TestApp", "hidden": true, "cacheVariables": { "GUCEF_BUILD_TARGET": "GUCEF_exe_gucefCORE_TestApp" } },
        { "name": "_target-GUCEF_tag_test",              "hidden": true, "cacheVariables": { "GUCEF_BUILD_TARGET": "GUCEF_tag_test"              } },
        { "name": "_target-GUCEF_tag_platform",          "hidden": true, "cacheVariables": { "GUCEF_BUILD_TARGET": "GUCEF_tag_platform"          } },
        { "name": "_target-GUCEF_tag_services",          "hidden": true, "cacheVariables": { "GUCEF_BUILD_TARGET": "GUCEF_tag_services"          } },
        { "name": "_target-GUCEF_tag_tools",             "hidden": true, "cacheVariables": { "GUCEF_BUILD_TARGET": "GUCEF_tag_tools"             } },

        // ---------------------------------------------------------------
        // Visible default presets: one per target, shown only on the
        // matching host OS. Each combines a _target-* + _comp-* via
        // multi-inheritance. displayName is just the target so the
        // picker stays clean (only one entry per target is visible).
        // ---------------------------------------------------------------

        // Windows defaults (VS2026 x64)
        {
            "name": "GUCEF_exe_gucefCORE_TestApp-Windows",
            "displayName": "GUCEF_exe_gucefCORE_TestApp",
            "inherits": [ "_target-GUCEF_exe_gucefCORE_TestApp", "_comp-VS2026-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_exe_gucefCORE_TestApp",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "GUCEF_tag_test-Windows",
            "displayName": "GUCEF_tag_test",
            "inherits": [ "_target-GUCEF_tag_test", "_comp-VS2026-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_test",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "GUCEF_tag_platform-Windows",
            "displayName": "GUCEF_tag_platform",
            "inherits": [ "_target-GUCEF_tag_platform", "_comp-VS2026-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_platform",
