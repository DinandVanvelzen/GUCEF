        {
            "name": "GUCEF_tag_test-Darwin",
            "displayName": "GUCEF_tag_test",
            "inherits": [ "_target-GUCEF_tag_test", "_comp-Ninja-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_test",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "GUCEF_tag_platform-Darwin",
            "displayName": "GUCEF_tag_platform",
            "inherits": [ "_target-GUCEF_tag_platform", "_comp-Ninja-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_platform",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "GUCEF_tag_services-Darwin",
            "displayName": "GUCEF_tag_services",
            "inherits": [ "_target-GUCEF_tag_services", "_comp-Ninja-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_services",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        },
        {
            "name": "GUCEF_tag_tools-Darwin",
            "displayName": "GUCEF_tag_tools",
            "inherits": [ "_target-GUCEF_tag_tools", "_comp-Ninja-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_tools",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
        }
    ],

    "buildPresets": [
        { "name": "GUCEF_exe_gucefCORE_TestApp-Windows-Debug",   "displayName": "GUCEF_exe_gucefCORE_TestApp | Debug",   "configurePreset": "GUCEF_exe_gucefCORE_TestApp-Windows", "configuration": "Debug"   },
        { "name": "GUCEF_exe_gucefCORE_TestApp-Windows-Release", "displayName": "GUCEF_exe_gucefCORE_TestApp | Release", "configurePreset": "GUCEF_exe_gucefCORE_TestApp-Windows", "configuration": "Release" },
