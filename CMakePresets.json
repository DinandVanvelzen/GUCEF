            "inherits": [ "_target-GUCEF_tag_services", "_comp-VS2026-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_services",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },
        {
            "name": "GUCEF_tag_tools-Windows",
            "displayName": "GUCEF_tag_tools",
            "inherits": [ "_target-GUCEF_tag_tools", "_comp-VS2026-x64" ],
            "binaryDir": "${sourceDir}/common/bin/preset-GUCEF_tag_tools",
            "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
        },

        // Linux defaults (Ninja x64)
        {
            "name": "GUCEF_exe_gucefCORE_TestApp-Linux",
