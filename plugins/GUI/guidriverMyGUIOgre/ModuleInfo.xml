<ModuleInfoEntry>
    <Module Name="guidriverMyGUIOgre" Type="SharedLibrary" Platform="All" Tags="plugin">
        <ModuleMetaData>
            <License>APACHEv2</License>
            <SemVer>2.0.0.0</SemVer>
            <DescriptionHeadline>MyGUI 3.5.4 driver for gucefGUI drawing inside Ogre 14 render windows</DescriptionHeadline>
            <DescriptionDetails>Uses the Ogre platform of MyGUI, which draws in the overlay render queue of the scene manager of the window of guidriverOgre. MyGUI reads its data and textures through the resource system of Ogre, which the Ogre glue plugins (OgrePlugin_GucefVFS, OgreCodec_GucefIMAGE) route into the virtual file system and gucefIMAGE. Built as C++17, which MyGUI requires.</DescriptionDetails>
            <Authors>
                <Author>Dinand Vanvelzen</Author>
            </Authors>
            <Maintainers>
                <Maintainer>Dinand Vanvelzen</Maintainer>
            </Maintainers>
        </ModuleMetaData>
        <Dependencies>
            <Dependency Name="guidriverMyGUI" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="gucefIMAGE" />
            <Dependency Name="gucefGUI" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefMT" />
            <Dependency Name="MyGUI.Engine" />
            <Dependency Name="MyGUI.OgrePlatform" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="guidriverMyGUI" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="gucefIMAGE" />
            <Dependency Name="gucefGUI" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefMT" />
            <Dependency Name="MyGUI.Engine" />
            <Dependency Name="MyGUI.OgrePlatform" />
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="GUIDRIVERMYGUIOGRE_BUILD_MODULE" />
        </Preprocessor>
        <Compiler MinCppStandard="17" />
    </Module>
</ModuleInfoEntry>
