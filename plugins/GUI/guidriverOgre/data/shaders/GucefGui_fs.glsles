#version 300 es

// Fragment program of the GUI material of guidriverOgre (COgreGuiMaterial). OpenGL ES 3.0 and WebGL 2.

precision mediump float;

uniform sampler2D guiTexture;

in vec4 guiColour;
in vec2 guiUv;

out vec4 fragColour;

void main()
{
    fragColour = guiColour * texture( guiTexture, guiUv );
}
