<ModuleInfoEntry>
    <Module Name="vfspluginDRN" Type="SharedLibrary" Platform="All" Tags="plugin">
        <ModuleMetaData>
            <License>Apache 2.0</License>
            <SemVer>0.1.0.0</SemVer>
            <DescriptionHeadline>GUCEF VFS plugin presenting a share of another DRN node as a VFS archive</DescriptionHeadline>
            <DescriptionDetails>Read only network drive over a DRN session: the namespace (lists, stats) comes from the namespace operations of the serving node and the bytes from the long lived handles of the resource transfer facility. The application provides the session; the archive does not discover, connect or authenticate.</DescriptionDetails>
            <Authors>
                <Author>Dinand Vanvelzen</Author>
            </Authors>
            <Maintainers>
                <Maintainer>Dinand Vanvelzen</Maintainer>
            </Maintainers>
        </ModuleMetaData>
        <Dependencies>
            <Dependency Name="gucefMT" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="gucefCOMCORE" />
            <Dependency Name="gucefCOM" />
            <Dependency Name="gucefWEB" />
            <Dependency Name="gucefDRN" />
        </Dependencies>
        <Linker>
            <Dependency Name="gucefMT" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="gucefCOMCORE" />
            <Dependency Name="gucefCOM" />
            <Dependency Name="gucefWEB" />
            <Dependency Name="gucefDRN" />
        </Linker>
        <Preprocessor>
            <Define String="GUCEF_VFSPLUGIN_DRN_BUILD_MODULE" />
        </Preprocessor>
    </Module>
</ModuleInfoEntry>
