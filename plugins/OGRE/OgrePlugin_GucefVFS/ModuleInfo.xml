<ModuleInfoEntry>
    <Module Name="OgrePlugin_GucefVFS" Type="SharedLibrary" Platform="All" Tags="plugin">
        <ModuleMetaData>
            <License>Apache 2.0</License>
            <SemVer>0.1.0.0</SemVer>
            <DescriptionHeadline>Ogre plugin that registers the archive factories which read through gucefVFS</DescriptionHeadline>
            <DescriptionDetails>Registers the Ogre archive types GucefVFS (a directory of the VFS), GucefIOAccess (named resources in memory as CIOAccess objects), FileSystem (as GucefVFS, for resource configuration that names it) and Zip (an archive file of the VFS, mounted while Ogre has it loaded). Ogre itself does not register archive factories that read from disk in this code base.</DescriptionDetails>
            <Authors>
                <Author>Dinand Vanvelzen</Author>
            </Authors>
            <Maintainers>
                <Maintainer>Dinand Vanvelzen</Maintainer>
            </Maintainers>
        </ModuleMetaData>
        <Dependencies>
            <Dependency Name="gucefHeaders" />
            <Dependency Name="gucefMT" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="pluginglueOGRECOMMON" />
            <Dependency Name="pluginglueOGRE" />
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="gucefMT" />
            <Dependency Name="gucefCORE" />
            <Dependency Name="gucefVFS" />
            <Dependency Name="pluginglueOGRE" />
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="GUCEF_OGREPLUGIN_GUCEFVFS_BUILD_MODULE" />
        </Preprocessor>
        <Compiler MinCppStandard="14" />
    </Module>
    <!-- WebAssembly builds link the plugin into the application, as a static library -->
    <Module Type="StaticLibrary" Platform="emscripten">
    </Module>
</ModuleInfoEntry>
