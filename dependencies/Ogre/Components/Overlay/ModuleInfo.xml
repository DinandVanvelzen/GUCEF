<ModuleInfoEntry>
    <ModuleMetaData>
        <License>MIT</License>
        <SemVer>14.6.3.0</SemVer>
        <DescriptionHeadline>OGRE Overlay component</DescriptionHeadline>
        <DescriptionDetails>The 2D overlay system of OGRE 14.6.3: overlays, panels, text areas and fonts (TrueType fonts through FreeType). The Dear ImGui integration of the component is not built.</DescriptionDetails>
    </ModuleMetaData>
    <Module Name="OgreOverlay" Type="SharedLibrary" Platform="All" Tags="ogre">
        <Dependencies>
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
            <Dependency Name="freetype" />
        </Dependencies>
        <Linker>
            <Dependency Name="Ogre" />
            <Dependency Name="freetype" />
        </Linker>
        <Preprocessor>
            <Define String="OgreOverlay_EXPORTS" />
            <Define String="HAVE_FREETYPE" />
        </Preprocessor>
        <Compiler MinCppStandard="14">
            <CompilerFlags CompilerName="G++" Flags="-fvisibility=hidden -fvisibility-inlines-hidden" />
            <CompilerFlags CompilerName="GCC" Flags="-fvisibility=hidden" />
            <CompilerFlags CompilerName="MSVC" Flags="/bigobj" />
        </Compiler>
    </Module>
    <!-- WebAssembly builds link the modules into the application, as static libraries -->
    <Module Type="StaticLibrary" Platform="emscripten">
    </Module>
</ModuleInfoEntry>
