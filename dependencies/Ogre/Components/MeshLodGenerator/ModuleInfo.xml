<ModuleInfoEntry>
    <ModuleMetaData>
        <License>MIT</License>
        <SemVer>14.6.3.0</SemVer>
        <DescriptionHeadline>OGRE Mesh Lod Generator component</DescriptionHeadline>
        <DescriptionDetails>Generates the levels of detail of meshes for OGRE 14.6.3.</DescriptionDetails>
    </ModuleMetaData>
    <Module Name="OgreMeshLodGenerator" Type="SharedLibrary" Platform="All">
        <Dependencies>
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="OGRE_MESHLODGENERATOR_EXPORTS" />
            <Define String="OGRE_GCC_VISIBILITY" />
        </Preprocessor>
        <Compiler MinCppStandard="14">
            <CompilerFlags CompilerName="G++" Flags="-fvisibility=hidden -fvisibility-inlines-hidden -fno-math-errno -ffp-contract=fast -fno-trapping-math" />
            <CompilerFlags CompilerName="GCC" Flags="-fvisibility=hidden" />
            <CompilerFlags CompilerName="MSVC" Flags="/bigobj /fp:contract" />
        </Compiler>
    </Module>
    <!-- WebAssembly builds link the modules into the application, as static libraries -->
    <Module Type="StaticLibrary" Platform="emscripten">
    </Module>
</ModuleInfoEntry>
