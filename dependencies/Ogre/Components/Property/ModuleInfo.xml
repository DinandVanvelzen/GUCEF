<ModuleInfoEntry>
    <ModuleMetaData>
        <License>MIT</License>
        <SemVer>14.6.3.0</SemVer>
        <DescriptionHeadline>OGRE Property component</DescriptionHeadline>
        <DescriptionDetails>Typed properties with binding to the members of objects, for OGRE 14.6.3.</DescriptionDetails>
    </ModuleMetaData>
    <Module Name="OgreProperty" Type="SharedLibrary" Platform="All" Tags="ogre">
        <Dependencies>
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="OgreProperty_EXPORTS" />
        </Preprocessor>
        <Compiler>
            <CompilerFlags CompilerName="G++" Flags="-std=c++14 -fvisibility=hidden -fvisibility-inlines-hidden" />
            <CompilerFlags CompilerName="GCC" Flags="-fvisibility=hidden" />
            <CompilerFlags CompilerName="MSVC" Flags="/bigobj" />
        </Compiler>
    </Module>
    <!-- WebAssembly builds link the modules into the application, as static libraries -->
    <Module Type="StaticLibrary" Platform="emscripten">
    </Module>
</ModuleInfoEntry>
