<ModuleInfoEntry>
    <ModuleMetaData>
        <License>MIT</License>
        <SemVer>14.6.3.0</SemVer>
        <DescriptionHeadline>OGRE OpenGL ES 2 and 3 render system plugin</DescriptionHeadline>
        <DescriptionDetails>The OpenGL ES 2 render system of OGRE 14.6.3, which uses ES 3 where available, a plugin of the Ogre core library. It is the render system of Android and of WebAssembly (WebGL), where it is a static library that is linked into the application; on Linux it runs on top of EGL. The OpenGL ES entry points are loaded at run time. Without GLSL optimiser and Cg support.</DescriptionDetails>
    </ModuleMetaData>
    <Module Name="OgreRenderSystem_GLES2" Type="SharedLibrary" Platform="linux;android;emscripten" Tags="ogre">
        <Dependencies>
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
            <Dependency Name="OgreGLSupport" />
        </Dependencies>
        <Linker>
            <Dependency Name="Ogre" />
            <Dependency Name="OgreGLSupport" />
        </Linker>
        <Preprocessor>
            <Define String="RenderSystem_GLES2_EXPORTS" />
            <Define String="OGRE_GCC_VISIBILITY" />
        </Preprocessor>
        <Compiler MinCppStandard="14">
            <CompilerFlags CompilerName="G++" Flags="-fvisibility=hidden -fvisibility-inlines-hidden" />
            <CompilerFlags CompilerName="GCC" Flags="-fvisibility=hidden" />
        </Compiler>
    </Module>
    <Module Type="StaticLibrary" Platform="emscripten">
    </Module>
    <Module Platform="linux;android">
        <Linker>
            <Dependency Name="dl" />
        </Linker>
    </Module>
</ModuleInfoEntry>
