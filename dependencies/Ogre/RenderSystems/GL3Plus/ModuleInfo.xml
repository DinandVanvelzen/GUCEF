<ModuleInfoEntry>
    <ModuleMetaData>
        <License>MIT</License>
        <SemVer>14.6.3.0</SemVer>
        <DescriptionHeadline>OGRE OpenGL 3+ render system plugin</DescriptionHeadline>
        <DescriptionDetails>The core profile OpenGL 3.3 and later render system of OGRE 14.6.3, a plugin of the Ogre core library. The OpenGL entry points are loaded at run time.</DescriptionDetails>
    </ModuleMetaData>
    <Module Name="OgreRenderSystem_GL3Plus" Type="SharedLibrary" Platform="linux;mswin" Tags="ogre">
        <Dependencies>
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
            <Dependency Name="OgreGLSupport" />
        </Dependencies>
        <Linker>
            <Dependency Name="Ogre" />
            <Dependency Name="OgreGLSupport" />
        </Linker>
        <Preprocessor>
            <Define String="RenderSystem_GL3Plus_EXPORTS" />
            <Define String="OGRE_GCC_VISIBILITY" />
        </Preprocessor>
        <Compiler MinCppStandard="14">
            <CompilerFlags CompilerName="G++" Flags="-fvisibility=hidden -fvisibility-inlines-hidden" />
            <CompilerFlags CompilerName="GCC" Flags="-fvisibility=hidden" />
            <CompilerFlags CompilerName="MSVC" Flags="/bigobj" />
        </Compiler>
    </Module>
    <Module Platform="linux">
        <Linker>
            <Dependency Name="dl" />
        </Linker>
    </Module>
</ModuleInfoEntry>
