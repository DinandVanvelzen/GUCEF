<ModuleInfoEntry>
    <ModuleMetaData>
        <License>MIT</License>
        <SemVer>14.6.3.0</SemVer>
        <DescriptionHeadline>OGRE STBI image codec plugin</DescriptionHeadline>
        <DescriptionDetails>Image codec of OGRE 14.6.3 based on the stb_image library, which reads and writes PNG, JPEG, BMP, TGA and other common image formats, a plugin of the Ogre core library. It is the image codec of WebAssembly builds of upstream.</DescriptionDetails>
    </ModuleMetaData>
    <Module Name="OgreCodec_STBI" Type="SharedLibrary" Platform="All" Tags="ogre">
        <Dependencies>
            <Dependency Name="Ogre.CommonInclude" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="Codec_STBI_EXPORTS" />
        </Preprocessor>
        <Compiler>
            <CompilerFlags CompilerName="G++" Flags="-std=c++14 -fvisibility=hidden -fvisibility-inlines-hidden" />
            <CompilerFlags CompilerName="GCC" Flags="-fvisibility=hidden" />
            <CompilerFlags CompilerName="MSVC" Flags="/bigobj" />
        </Compiler>
    </Module>
    <!-- WebAssembly builds link the modules into the application, as static libraries -->
    <Module Type="StaticLibrary" Platform="emscripten">
    </Module>
</ModuleInfoEntry>
