            <Dependency Name="MyGUI.Engine" />
            <Dependency Name="MyGUI.Common.FileSystemInfo" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="MyGUI.Engine" />
