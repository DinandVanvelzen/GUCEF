<ModuleInfoEntry>
    <Module Name="aws-c-http" Type="StaticLibrary" Platform="All">
        <Preprocessor>		
        </Preprocessor>
        <Dependencies>
            <Dependency Name="aws-c-common" />
            <Dependency Name="aws-c-common-headers" />
            <Dependency Name="aws-c-io" />
            <Dependency Name="aws-c-io-headers" />
            <Dependency Name="aws-c-compression" />
            <Dependency Name="aws-c-compression-headers" />			
			<Dependency Name="aws-c-http-headers" />
        </Dependencies>
        <Linker>
            <Dependency Name="aws-c-common" />
			<Dependency Name="aws-c-io" />
			<Dependency Name="aws-c-compression" />
        </Linker>		
    </Module>
    <Module Platform="linux">
        <Preprocessor>
            <Define String="BYO_CRYPTO" /> <!-- s2n is not part of our dependencies, TLS is handled by the HTTP client of the SDK (curl) -->
        </Preprocessor>
    </Module>
</ModuleInfoEntry>
