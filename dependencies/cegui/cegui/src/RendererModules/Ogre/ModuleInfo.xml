<ModuleInfoEntry>
    <Module Name="CEGUI.RendererModule.Ogre" Type="SharedLibrary" Platform="All">
        <Dependencies>
            <Dependency Name="CEGUI" />
            <Dependency Name="CEGUI.Includes" />
            <Dependency Name="Ogre" />
        </Dependencies>
        <Linker>
            <Dependency Name="CEGUI" />
            <Dependency Name="Ogre" />
        </Linker>
        <Preprocessor>
            <Define String="CEGUIOGRERENDERER_EXPORTS" />
        </Preprocessor>
        <!-- the headers of Ogre need C++14, which MSVC does by default -->
        <Compiler>
            <CompilerFlags CompilerName="G++" Flags="-std=c++14" />
        </Compiler>
    </Module>
</ModuleInfoEntry>
