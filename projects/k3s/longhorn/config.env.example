# Longhorn settings for this cluster.
# Copy this file to config.env to change settings. config.env is gitignored.
# All settings are optional; the values shown are the defaults.

# Replicas per Longhorn volume. 1 = no extra copies; redundancy comes from the
# node's disk setup (RAID / mirrored disks). On a multi-node cluster a higher
# value places copies on different nodes.
#LONGHORN_REPLICA_COUNT=1
