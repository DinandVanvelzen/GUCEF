# NVIDIA GPU settings for this k3s node.
# Copy this file to config.env to change settings. config.env is gitignored.
# All settings are optional; the values shown are the defaults.

# Minimum NVIDIA driver major version. If the loaded/installed driver is older,
# setup-host.sh installs a newer one (Ubuntu only). 570 is the first branch with
# native CUDA 12.8 support, which the llama.cpp CUDA images require.
#NVIDIA_MIN_DRIVER_VERSION=570

# Driver package to install when an upgrade is needed.
# Empty = use the package recommended by 'ubuntu-drivers devices'.
#NVIDIA_DRIVER_PACKAGE=nvidia-driver-595-open

# How many pods may share one physical GPU (time-slicing).
# Note: time-slicing does not isolate VRAM, the pods must fit in VRAM together.
#GPU_TIMESLICE_REPLICAS=4

# Version of the NVIDIA k8s device plugin helm chart
#NVIDIA_DEVICE_PLUGIN_VERSION=0.20.1
