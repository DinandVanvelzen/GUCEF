# IRC server (Ergo) settings. All optional: defaults are shown or described.
# To change one, copy this file to config.env (gitignored) and uncomment it.

# Administrator account: channel owner everywhere, may /OPER admin.
# Default: the login name of the user running setup.sh, in lower case.
#IRC_ADMIN_ACCOUNT=myname

# Other accounts, space separated (lower case letters, digits, underscore).
# setup.sh creates missing accounts with a generated password and gives them access to the
# channels in IRC_CHANNELS. Passwords: secrets.env, copied to ~/.config/gucef-k3s/irc-secrets.env.
#IRC_ACCOUNTS="alice bob"

# Channels created by setup.sh: registered, invite-only, open to all accounts above.
#IRC_CHANNELS="#family"

# Address or DNS name clients use to reach the server; also in the TLS certificate.
# Default: the IP of IRC_NODE.
#IRC_HOST=myserver.lan

# Node the server runs on; clients connect to a port on this node.
# Default: the first node that is not ephemeral.
#IRC_NODE=

# IRC over TLS for the LAN and the tailnet (a host port of IRC_NODE)
#IRC_LAN_PORT=32004

# Network name shown by clients, and the server name
#IRC_NETWORK_NAME=HomeIRC
#IRC_SERVER_NAME=irc.home.lan

# How long chat history is kept
#IRC_HISTORY_EXPIRE=52w

# Size and storage class of the volume for accounts and channel registrations.
# Default storage class: longhorn-raid if the cluster has it, otherwise the cluster default.
#IRC_PVC_SIZE=1Gi
#IRC_STORAGE_CLASS=

# Ergo container image, pinned by digest. Override to upgrade Ergo.
#IRC_ERGO_IMAGE=ghcr.io/ergochat/ergo:v2.19.1@sha256:ef885e44f7fa19101bbbc41baef11dc280dc8107465dccaf6f0860f41b48a682

# ---------------------------------------------------------------------------
# LLM bots (gucefIrcHub)
# ---------------------------------------------------------------------------
# enabled (default) or none
#IRC_HUB=enabled

# The bots. Each has an account of its own, a room (#<name>) where it answers everything, and
# joins the shared channels, where it answers messages addressed to it ("qwen: ...").
# A bot runs when its model can be reached: qwen needs the local LLM server (../llm), the others
# their API key in secrets.env (IRC_ANTHROPIC_API_KEY, IRC_OPENAI_API_KEY, IRC_GEMINI_API_KEY,
# IRC_XAI_API_KEY). Your own bot: add its name and set at least its VENDOR and BASE_URL.
#IRC_BOTS="qwen claude gpt gemini grok"

# Shared channels the bots join. Default: IRC_CHANNELS
#IRC_BOT_CHANNELS="#family"

# Tokens one person may use per bot per day (UTC) of a cloud model; 0: no limit. qwen: no limit.
#IRC_BOT_DAILY_TOKENS=200000

# Per bot: IRC_BOT_<NAME>_<SETTING>, for example for claude:
#IRC_BOT_CLAUDE_VENDOR=anthropic          # anthropic, openai, openai-compatible or llamacpp
#IRC_BOT_CLAUDE_BASE_URL=https://api.anthropic.com/v1
#IRC_BOT_CLAUDE_MODEL=claude-opus-5-5
#IRC_BOT_CLAUDE_EFFORT=low                # anthropic only: low, medium, high, xhigh, max
#IRC_BOT_CLAUDE_API_KEY=IRC_ANTHROPIC_API_KEY   # the name of the key in secrets.env
#IRC_BOT_CLAUDE_DISPLAY_NAME="Claude, by Anthropic"
#IRC_BOT_CLAUDE_ROOM="#claude"
#IRC_BOT_CLAUDE_CHANNELS="#family"
#IRC_BOT_CLAUDE_DAILY_TOKENS=200000
#IRC_BOT_CLAUDE_MAX_TOKENS=4096
#IRC_BOT_CLAUDE_SYSTEM_PROMPT=""          # empty: plain text, short answers, suitable for all ages
# Defaults of the others: gpt (openai, gpt-5), gemini (openai-compatible, gemini-2.5-flash),
# grok (openai-compatible, grok-4), qwen (llamacpp, llama-server in namespace llm).
