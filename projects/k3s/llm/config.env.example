# Local LLM server (llama.cpp llama-server) settings.
# Copy this file to config.env to change settings. config.env is gitignored.
# All settings are optional; when unset, values are auto-detected or the shown defaults apply.

# Model to serve, as Hugging Face GGUF "<repo>:<quant>".
# Unset = chosen automatically from GPU VRAM and the memory available to the LLM pod:
#   memory limit >= 32 GiB          -> unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M  (MoE, experts offloaded to RAM)
#   VRAM >= 7 GB or memory >= 12 GiB -> unsloth/Qwen3.5-9B-GGUF:Q4_K_M
#   otherwise                       -> unsloth/Qwen3.5-4B-GGUF:Q4_K_M
#LLM_MODEL_HF=unsloth/Qwen3.6-35B-A3B-GGUF:Q4_K_M

# Model name reported by the API (/v1/models) and used by clients
#LLM_MODEL_ALIAS=local-qwen

# Hugging Face token, only needed for gated/private model repos
#HF_TOKEN=

# Context size in tokens. Claude Code needs at least 100000 to compact its
# conversation before the window is full.
#LLM_CTX_SIZE=131072

# Number of requests processed concurrently (they share the context size)
#LLM_PARALLEL=1

# Load the multimodal projector (image input) when the model has one. Uses extra VRAM.
#LLM_MULTIMODAL=false

# VRAM in MiB to leave free on the GPU for other workloads (llama-server --fit-target)
#LLM_VRAM_RESERVE_MIB=1024

# Resource limits for the llama-server pod.
# Defaults: 50% of the node's allocatable memory and CPU cores.
#LLM_MEMORY_LIMIT=64Gi
#LLM_CPU_LIMIT=14

# Storage for downloaded model files. Model files are re-downloadable, so the
# scratch class is used. Falls back to the cluster default StorageClass when absent.
#LLM_STORAGE_CLASS=longhorn-jbod
#LLM_STORAGE_SIZE=100Gi

# Port of the LoadBalancer service on the node IP
#LLM_PORT=8080

# API key required by clients ("Authorization: Bearer <key>" or "x-api-key: <key>").
# Unset = no authentication; keep the port LAN-only.
#LLM_API_KEY=

# Extra llama-server arguments, appended last
#LLM_EXTRA_ARGS=

# Container images (pinned by digest). Override to upgrade llama.cpp.
#LLM_IMAGE_CUDA=ghcr.io/ggml-org/llama.cpp:server-cuda@sha256:a361e47e28e8801e290f3c855292e0f25047e5d8e998b0d101431f54db68e008
#LLM_IMAGE_CPU=ghcr.io/ggml-org/llama.cpp:server@sha256:4d2de15a0ffbce704777c64026b40512a71e0bbc0b303a5fe5ea9bf71760dff9
