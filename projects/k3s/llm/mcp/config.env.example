# Settings of the MCP service gucef-mcp on this machine (llm/mcp/install.sh).
# Copied to config.env (not in git) on the first run; uncomment to change.

# Port of the local listener, http://127.0.0.1:MCP_PORT/mcp, for Claude sessions on this machine
#MCP_PORT=8790

# Port of the HTTPS listener on every address of this machine, for sessions on other machines
#MCP_TLS_PORT=8791

# Commands run_and_digest may run, separated by |; * and ? are wildcards. Empty: run_and_digest is not offered
#MCP_ALLOW_COMMANDS="cmake --build *|ctest *|ninja *|make *"

# The model calls use when they name none, as the LLM servers report it. Empty: any model
#MCP_MODEL=

# Register the local listener with Claude Code of the user (claude mcp add --scope user)
#MCP_REGISTER_CLAUDE=true

# The name it is registered under
#MCP_CLAUDE_NAME=local-llm
