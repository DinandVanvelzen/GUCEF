# Settings of gucefMcpCi on this machine (ci/mcp/install.sh).
# Copied to config.env (not in git) on the first run; uncomment to change.

# gateway on the k3s server node next to the lablink hub, client elsewhere; empty: detected
# (gateway when /etc/systemd/system/k3s.service exists)
#CI_ROLE=

# The name the server is registered under with Claude Code of the user (claude mcp add --scope user)
#CI_MCP_NAME=ci

# Register the server with Claude Code of the user that runs install.sh with sudo
#CI_REGISTER_CLAUDE=true

# Client without lablink: the gateway, https://host:port. Empty: the gateway lablink names in /var/lib/gucef-mcp/ci.
# Gateway: the URL the lablink hub announces to the machines; empty: https://<host name>:CI_GATEWAY_PORT
#CI_GATEWAY_URL=

# Client without lablink: the file with the gateway token of this machine, owned by the user Claude Code runs as,
# mode 0600. Empty: gateway.token of the lablink directory
#CI_GATEWAY_TOKEN_FILE=

# Client without lablink: the PEM file of the authority that signed the certificate of the gateway (ca.crt of
# /var/lib/gucef-mcp/tls on the gateway machine). Empty: ca.crt of the lablink directory
#CI_CA_FILE=

# Gateway: the HTTPS port of the gateway API. The firewall role ci-gateway opens 8792 only
#CI_GATEWAY_PORT=8792

# Gateway: the system user the service gucef-ci-gateway runs as; made when missing
#CI_GATEWAY_USER=gucef-ci

# Gateway: the networks the gateway port is opened to in the firewall, separated by spaces.
# Empty: the networks of this machine's interfaces
#CI_ALLOW="172.16.0.0/24 172.16.1.0/24"

# Gateway: the approved machines whose gateway token may also deploy (the scope deploy), as gucefLabLink --list names
# them or by machine id, separated by commas. Set as LAB_CI_DEPLOY_MACHINES of the lablink hub. Commented out: the
# setting of the hub stays as it is; set but empty: no machine may deploy.
#CI_DEPLOY_MACHINES=workstation
