# Settings for the top-level setup.sh. Optional: copy to config.env (gitignored) to change them.

# Git server to install: forgejo (default) or none.
#GIT_SERVER=forgejo

# CI to install: jenkins (default), forgejo (Forgejo Actions runner), all, or none.
# forgejo and all need GIT_SERVER=forgejo.
#CI_ENGINE=jenkins

# The lab link: this k3s server node becomes the hub of the home lab, with its website on 47813/tcp
# (default true; the website needs the MCP certificate of llm/mcp/cluster.sh, see lablink/config.env.example).
#LABLINK=true

# The CI gateway of gucefMcpCi on this k3s server node (ci/mcp/install.sh --role gateway), through which the CI MCP servers
# of the lab machines run the build matrix on Forgejo Actions: true, false, or auto (default: installed when Forgejo CI is
# selected, GIT_SERVER=forgejo and CI_ENGINE=forgejo or all, skipped otherwise). Runs after the lab link and Forgejo; its
# own settings are in ci/mcp/config.env.example.
#CI_GATEWAY=auto
