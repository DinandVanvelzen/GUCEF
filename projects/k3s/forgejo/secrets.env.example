# Forgejo credentials. If secrets.env does not exist, create-sealed-secret.sh
# generates it with random passwords and keeps a copy in
# ~/.config/gucef-k3s/forgejo-secrets.env. To choose your own values, copy this
# file to secrets.env and edit it.
# secrets.env is gitignored - never commit it
#
# After editing secrets.env, run create-sealed-secret.sh to generate
# the sealed-secret.yaml that is safe to commit to git.
# Re-run create-sealed-secret.sh after every full cluster rebuild (new Sealed Secrets key pair).

# Password of the forgejo database user in my-postgres.
FORGEJO_DB_PASSWORD=change-me-forgejo-db-password

# Password of the Forgejo admin user (FORGEJO_ADMIN_USER from config.env).
FORGEJO_ADMIN_PASSWORD=change-me-forgejo-admin-password

# Optional: GitHub token for private imports and push mirrors.
GITHUB_TOKEN=
