# Forgejo deployment settings. All optional: defaults are shown or described.
# To change one, copy this file to config.env (gitignored) and uncomment it.

# Address or DNS name clients use to reach Forgejo.
# Default: the IP of the first cluster node.
#FORGEJO_HOST=myserver.lan

# Web UI port (a LoadBalancer port) and SSH port for git.
#FORGEJO_HTTP_PORT=32001
#FORGEJO_SSH_PORT=32002

# Size and storage class of the data volume.
# Default storage class: longhorn-raid if the cluster has it, otherwise the cluster default.
#FORGEJO_PVC_SIZE=100Gi
#FORGEJO_STORAGE_CLASS=

# Admin account created on first setup. Its password is generated, see README.md.
#FORGEJO_ADMIN_USER=forgejo-admin
#FORGEJO_ADMIN_EMAIL=admin@localhost.localdomain

# Space separated organizations created (private) by setup.sh.
#FORGEJO_ORGS="ExampleOrg1 ExampleOrg2"

# Helm chart version of oci://code.forgejo.org/forgejo-helm/forgejo
#FORGEJO_CHART_VERSION=17.3.2

# CI scratch repository (scratch-repo.sh): owner and name of the writable repository that receives the
# scratch/* snapshot branches, the bot user, and the age in days after which --prune deletes scratch branches.
#FORGEJO_CI_OWNER=ci
#FORGEJO_CI_REPO=GUCEF
#FORGEJO_CI_BOT_USER=ci-bot
#FORGEJO_CI_BOT_EMAIL=ci-bot@localhost.localdomain
#FORGEJO_CI_PRUNE_DAYS=14

# Image build runner (runner/setup.sh --oci): a second runner, isolated from forgejo-runner, whose jobs run in host mode
# in the runner container with buildctl and a BuildKit daemon beside it. Labels must be <label>:host labels.
#FORGEJO_RUNNER_OCI_LABELS=gucef-oci:host
#FORGEJO_RUNNER_OCI_CAPACITY=1
#FORGEJO_RUNNER_OCI_STORAGE_SIZE=40Gi
# Default: FORGEJO_RUNNER_VERSION
#FORGEJO_RUNNER_OCI_VERSION=13.2.1
# The node the runner is bound to (kubernetes.io/hostname). Rootless BuildKit needs unprivileged user namespaces:
# kernel.apparmor_restrict_unprivileged_userns=0 (Ubuntu 23.10 and later restrict them by default). Default: any node.
#FORGEJO_RUNNER_OCI_NODE=worker-x299
# Alpine packages the entry point installs for the jobs (apk add at every pod start).
#FORGEJO_RUNNER_OCI_PACKAGES="bash git curl python3 nodejs coreutils"
# rootless (default: user namespaces, seccomp and AppArmor unconfined for the daemon container) or privileged (a
# privileged daemon container, the fallback when rootless cannot run on the node).
#FORGEJO_BUILDKIT_MODE=rootless
# The BuildKit image. Default: moby/buildkit:<FORGEJO_BUILDKIT_VERSION>-rootless, or moby/buildkit:<version> in
# privileged mode. Pinned to a release; check the tag exists before a deployment and move it deliberately.
#FORGEJO_BUILDKIT_VERSION=v0.23.2
#FORGEJO_BUILDKIT_IMAGE=moby/buildkit:v0.23.2-rootless
# The container registry BuildKit treats as plain HTTP (buildkitd.toml), and the default --registry of
# registry/setup-node.sh and registry/push-base-image.sh. Default for runner/setup.sh: FORGEJO_HOST (or the first node
# address) and FORGEJO_HTTP_PORT; the registry scripts run on nodes without the cluster and take FORGEJO_HOST and
# FORGEJO_HTTP_PORT only, else they need --registry.
#FORGEJO_REGISTRY_HOST=172.16.1.125:32001
# Host names the image build runner pod resolves to the address of FORGEJO_REGISTRY_HOST (hostAliases), when that is an
# IPv4 address; space or comma separated, empty for none. The registry names its token service by the host of the
# Forgejo ROOT_URL (Www-Authenticate: Bearer realm="http://worker.lan:32001/v2/token"), which the cluster DNS need not
# resolve inside a pod.
#FORGEJO_REGISTRY_ALIASES=worker.lan
