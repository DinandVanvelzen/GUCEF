#
# The parameters of one GUCEF service for the scripts and templates of projects/k3s/gucef_service. A service keeps its
# own copy (for example projects/k3s/<service>/service.env) next to its Dockerfile, bootstrap file and site settings.
# Format: KEY=value per line, '#' starts a comment line, one pair of surrounding quotes is removed, nothing is expanded.
# Relative paths are relative to the directory of this file. No secret belongs in this file: secrets are created in the
# cluster (Secrets) or in the service's own credential store, never here. The values below are examples.

# ---- identity ---------------------------------------------------------------------------------------------------------
# the DNS label of the service: the name of the Deployment, Service, ConfigMap, claim and container
SERVICE_NAME=example-service
# the namespace (created with the Pod Security standard "restricted")
NAMESPACE=gucef-example
# the app.kubernetes.io/part-of label
PART_OF=gucef
# the executable of the service in bin/ (the target builds it); the image root is /opt/<SERVICE_NAME>
SERVICE_PROGRAM=ExampleService

# ---- image ------------------------------------------------------------------------------------------------------------
# the image repository; containerd keeps it as docker.io/<IMAGE_NAME>:<IMAGE_TAG>
IMAGE_NAME=vanvelzen/example-service
# the tag the manifests use (build_image.sh prints the tag it built)
IMAGE_TAG=dev
# the CMake build targets of the image (directories below projects/CMake/targets of TARGETS_CHECKOUT), space separated
IMAGE_TARGETS="GUCEF_exe_ExampleService"
# the checkout whose projects/CMake/targets holds IMAGE_TARGETS: GUCEF, or the name of one of EXTRA_CHECKOUTS
TARGETS_CHECKOUT=GUCEF
# further checkouts in the build context, "name=path" space separated (path relative to this file or absolute); each is
# copied to src/<name> of the context, GUCEF always to src/GUCEF
EXTRA_CHECKOUTS=""
# the bootstrap file of the service in the image (plugins taken from plugins/), relative to this file
BOOTSTRAP_INI=ExampleService_bootstrap_container.ini
# runtime packages beyond the base set (ca-certificates, libstdc++6, the libssl runtime of the release, libx11-6)
RUNTIME_EXTRA_PACKAGES=""
# the Dockerfile; empty: the generic template docker/gucef_service.dockerfile.template
DOCKERFILE=""
# legacy, keep it empty: GUCEF programs load their plugins through their bootstrap file. "lib" and/or "bin": a symbolic
# link there to every plugin of plugins/, for a program that loads its plugins as $MODULEDIR$/<name> (its own folder, then
# lib/ next to it) instead of through its bootstrap file
PLUGIN_LINKS=""
# further programs of the image, "name=directory" space separated: external tools the service starts as child processes. Each
# is built by IMAGE_TARGETS (as a module the service program lists as a runtime dependency) and staged next to the program;
# the licence files of the directory (relative to the targets checkout) are copied to /opt/<SERVICE_NAME>/licences/<last
# part of the directory>/
EXTRA_PROGRAMS=""

# ---- network ----------------------------------------------------------------------------------------------------------
# the session listener (the DRN link of clients), exposed through the LoadBalancer Service
SESSION_PORT=47400
# the pairing listener (open only while a pairing window is), exposed through the LoadBalancer Service
PAIRING_PORT=47401
# the health endpoints (/health/started, /health/ready, /health/live, /info): pod network only, in no Service
HEALTH_PORT=47480
# the loopback admin endpoint (127.0.0.1 inside the pod, kubectl exec): in no Service, not published
ADMIN_PORT=47403

# ---- LAN discovery ----------------------------------------------------------------------------------------------------
# lan (the default): the service also answers "which services are there" on the local network (generic GUCEF discovery;
#      a remote service host does so by default, "lanDiscovery": false switches it off). A pod network does not receive
#      LAN broadcasts, so the pod runs on the host network of DISCOVERY_NODE_NAME, the Service becomes ClusterIP and the
#      namespace is "privileged" (README.md, "LAN discovery": what that weakens).
# off: the service is reached at its configured endpoint only (a DNS name such as worker.lan or an address, and
#      SESSION_PORT), through the LoadBalancer Service, under the restricted Pod Security standard.
DISCOVERY_MODE=lan
# REQUIRED in lan mode, the rendering refuses without it: the node the pod runs on (kubectl get nodes; its
# kubernetes.io/hostname label), the node whose addresses answer on the LAN, for example the node of worker.lan
DISCOVERY_NODE_NAME=""
# the UDP port of the broadcast and multicast discovery clients of the service (GUCEF default 47800)
DISCOVERY_PORT=47800

# ---- storage ----------------------------------------------------------------------------------------------------------
DATA_SIZE=20Gi
# the StorageClass of the /data claim, resolved against the classes the target cluster has (scripts/
# resolve_storage_class.sh; render_manifests.sh --storage-classes-file or --query-cluster, deploy.sh always):
#   auto        (the default, also for a service file without the key) the first of raid, mirror, jbod, local-path of
#               which the cluster has a candidate class
#   raid        longhorn-raid, else raid        (the Longhorn-managed class wins when both exist)
#   mirror      longhorn-mirror, else mirror
#   jbod        longhorn-jbod, else jbod
#   local-path  local-path
#   <name>      any other value is a StorageClass name, used as it is (with a class list: it must be in it)
# raid and jbod without the prefix are the local-path based classes of projects/k3s/host-node/storage-classes.yaml,
# the longhorn-* ones those of projects/k3s/longhorn. Nothing matching refuses the rendering with the classes found:
# there is no fallback. The class of an existing claim cannot change (deploy.sh refuses a different resolution).
STORAGE_CLASS=auto
# the size limit of the /tmp emptyDir
TMP_SIZE=512Mi

# ---- placement and resources ------------------------------------------------------------------------------------------
# the node label the pod is bound to (the local-path claim and the imported image live on one node):
#   kubectl label node <node> <NODE_SELECTOR_KEY>=<NODE_SELECTOR_VALUE>
NODE_SELECTOR_KEY=gucef-service-host
NODE_SELECTOR_VALUE="true"
CPU_REQUEST=100m
MEMORY_REQUEST=384Mi
MEMORY_LIMIT=2Gi

# ---- lifecycle --------------------------------------------------------------------------------------------------------
# the drain time of the service (its own setting; written here so that the grace period is consistent with it)
DRAIN_SECONDS=20
# drain + closing + margin; the kubelet kills the container after it
TERMINATION_GRACE_SECONDS=45
# startup probe: period 10 s times this many failures covers lock waits and migrations
STARTUP_FAILURE_THRESHOLD=30

# ---- configuration ----------------------------------------------------------------------------------------------------
# the site settings file of the ConfigMap (mounted read-only at /opt/<SERVICE_NAME>/config/site/<SITE_CONFIG_NAME>)
SITE_CONFIG_NAME=ExampleService.json
# the file whose content becomes that ConfigMap entry, relative to this file
SITE_CONFIG_SOURCE=ExampleService_site.json
# the arguments of the container (the program is the entry point)
CONTAINER_ARGS="--console --data-dir /data --config /opt/example-service/config/site/ExampleService.json"

# ---- a secret as a file (components/secret-file), optional ------------------------------------------------------------
# One key of a Secret mounted read-only as <SECRET_FILE_MOUNT_DIR>/<SECRET_FILE_KEY>, for a value the program reads from
# a file its site settings name (for example a database password). Empty SECRET_FILE_SECRET_NAME: no such mount. Set:
# the component is rendered and enabled, and deploy.sh refuses the rollout while the Secret or its key is missing. The
# Secret is created in the cluster, never from a file of a repository (README.md, "Secrets"):
#   ( set -a; . <env file>; printf '%s' "$<VARIABLE>" ) | kubectl -n <NAMESPACE> create secret generic <SECRET_FILE_SECRET_NAME> --from-file=<SECRET_FILE_KEY>=/dev/stdin
SECRET_FILE_SECRET_NAME=""
# the key in the Secret and the file name (letters, digits, '_')
SECRET_FILE_KEY=password
# a directory of its own, not below /data, /tmp or /opt
SECRET_FILE_MOUNT_DIR=/secrets/example-service-db
# the file mode; the kubelet adds group read for the pod's group 10001 (fsGroup), so 0400 is root:10001 0440 on the node
SECRET_FILE_MODE=0400

# ---- a node-mounted network share (components/host-share), optional --------------------------------------------------
# A CIFS/SMB or NFS share that the node mounts (README.md, "A network share of the node"), in the pod at
# HOST_SHARE_MOUNT_PATH. Set these in the local install configuration (service.env.local), not in a file of a
# repository: they name the site's storage. Empty HOST_SHARE_HOST_PATH: no share.
# HOST_SHARE_HOST_PATH: the directory on the node, at or below the mount of the share; any characters except control
#   characters. The value is taken literally; one pair of surrounding quotes is removed, so a path with spaces or
#   '-== ==-' is written as HOST_SHARE_HOST_PATH='/mnt/<share>/-== <folder> ==-/<service>'
HOST_SHARE_HOST_PATH=""
# where the pod sees it (letters, digits, '.', '_', '-'; not below /data, /tmp or /opt)
HOST_SHARE_MOUNT_PATH=/share
# optional: a directory below HOST_SHARE_HOST_PATH, joined to it (the hostPath is the joined path)
HOST_SHARE_SUBPATH=""
# the file system types the init container accepts for the path; anything else (the node's own disk) stops the pod
HOST_SHARE_FSTYPES="cifs smb3 nfs nfs4"

# ---- credentials key (components/credentials-key), optional ----------------------------------------------------------
# the Secret holding the key file "credentials.key", created in the cluster (README.md), never in this repository.
# Empty: the component is not rendered (a program that keeps its credential store key on /data needs none)
CREDENTIALS_SECRET_NAME=example-service-credentials-key
# the environment variables through which the program takes the key file path and its trust mode
CREDENTIALS_KEY_FILE_ENV=EXAMPLE_CREDENTIALS_KEY_FILE
CREDENTIALS_KEY_TRUST_ENV=EXAMPLE_CREDENTIALS_KEY_TRUST
