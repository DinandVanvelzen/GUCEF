# MySQL credentials. If secrets.env does not exist, create-sealed-secret.sh
# generates it with a random password and keeps a copy in
# ~/.config/gucef-k3s/mysql-secrets.env. To choose your own value, copy this
# file to secrets.env and edit it.
# secrets.env is gitignored - never commit it
#
# After editing secrets.env, run create-sealed-secret.sh to regenerate sealed-secret.yaml.
# Re-run create-sealed-secret.sh after every full cluster rebuild (new Sealed Secrets key pair).
# Changing the password of an existing installation is not applied by setup.sh: MySQL keeps
# the root password it was initialized with.

MYSQL_ROOT_PASSWORD=change-me-mysql-root-password
