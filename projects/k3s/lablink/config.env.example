# Settings of gucef-lablink on this machine (lablink/install.sh).
# Copied to config.env (not in git) on the first run; uncomment to change.

# cluster on a k3s server node, machine elsewhere; empty: detected
#LAB_ROLE=

# Address ranges peers may be in, separated by spaces. Empty: the networks of this machine's interfaces
#LAB_ALLOW="172.16.0.0/24 172.16.1.0/24"

# Discovery: mDNS (DNS-SD) and UDP broadcast
#LAB_MDNS=true
#LAB_BROADCAST=true

# Cluster: the name it announces; empty: the host name
#LAB_CLUSTER_NAME=

# Machine: join the cluster as a node when this machine is not one (Linux, agent-node/join.sh)
#LAB_JOIN=true

# Machine: join as a node that is always on, instead of an ephemeral one
#LAB_PERMANENT=false

# A Linux machine with an NVIDIA GPU that joins gets an LLM server of the cluster
# on that GPU (llm/mcp/cluster.sh on the cluster sets it up); false: it does not.
# Applies when the machine joins.
#LAB_LLM=true

# Machine: whose Claude Code gets the MCP services of the nodes; empty: the user that ran sudo
#LAB_CLAUDE_USER=
