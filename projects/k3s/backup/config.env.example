# Backup settings. Copy to config.env (gitignored) and uncomment what differs from the defaults.

# NAS (SMB/CIFS) that receives the backups. The share needs a dedicated read-write account.
#BACKUP_NAS_HOST=nas.lan
#BACKUP_NAS_SHARE=k3s-backup

# Where the share is mounted on the k3s server node (used by the host-side backups and the CronJobs).
#BACKUP_MOUNT=/media/backup

# Kubernetes node name that has the share mounted. Auto-detected (this host) when empty.
#BACKUP_NODE=

# Longhorn volume backups: cron schedules and number of backups kept.
#BACKUP_DAILY_CRON="0 2 * * *"
#BACKUP_DAILY_RETAIN=14
#BACKUP_WEEKLY_CRON="0 3 * * 0"
#BACKUP_WEEKLY_RETAIN=8

# PostgreSQL dump CronJob schedule and number of dumps kept.
#BACKUP_PG_CRON="30 1 * * *"
#BACKUP_PG_RETAIN=14

# Forgejo bare-repository mirror CronJob schedule.
#BACKUP_FORGEJO_CRON="0 4 * * *"
