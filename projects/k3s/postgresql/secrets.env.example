# PostgreSQL credentials - copy this file to secrets.env and fill in your values
# secrets.env is gitignored - never commit it
#
# After editing secrets.env, run create-sealed-secret.sh to generate
# the sealed-secret.yaml that is safe to commit to git.
# Re-run create-sealed-secret.sh after every full cluster rebuild (new Sealed Secrets key pair).

POSTGRES_PASSWORD=change-me-superuser-password

# Password for the immich database user.
# Only used if Immich is installed. The same value must be in immich/secrets.env.
IMMICH_DB_PASSWORD=change-me-immich-db-password
