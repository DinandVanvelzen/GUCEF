#
# The asset store service (tools/AssetStoreService) on the k3s cluster: the service file of the scripts and templates
# of projects/k3s/gucef_service (its service.env.example documents every key). Format: KEY=value per line, '#' starts a
# comment line, one pair of surrounding quotes is removed, nothing is expanded. Relative paths are relative to this
# folder. No secret belongs in this file: the database password is a Secret of the cluster (README.md).

# ---- identity ---------------------------------------------------------------------------------------------------------
SERVICE_NAME=assetstore
NAMESPACE=assetstore
PART_OF=gucef
SERVICE_PROGRAM=AssetStoreService

# ---- image ------------------------------------------------------------------------------------------------------------
IMAGE_NAME=vanvelzen/asset-store-service
# the tag the manifests use; build_image.sh prints the tag it built (set it here, or keep building with --tag dev)
IMAGE_TAG=dev
IMAGE_TARGETS="GUCEF_exe_AssetStoreService"
TARGETS_CHECKOUT=GUCEF
EXTRA_CHECKOUTS=""
# the bootstrap file of the image: the program loads its plugins through it (from plugins/, stage_install.sh points every
# "Path" there); check_libs.sh fails the image build when a required one is missing
BOOTSTRAP_INI=AssetStoreService_bootstrap_container.ini
RUNTIME_EXTRA_PACKAGES=""
DOCKERFILE=""
# not needed: the program loads its plugins through the bootstrap file, from plugins/
PLUGIN_LINKS=""
# the Unreal asset reader starts ooz_extract (GPL-3.0-or-later, dependencies/ooz) as a child process: it is staged next to
# the program, with COPYING and README.txt under licences/ooz/
EXTRA_PROGRAMS="ooz_extract=dependencies/ooz"

# ---- network (the program's defaults; its site settings name the same ports) -----------------------------------------
# sessions and the bulk links of the clients (a bulk link is a second TCP connection to this port)
SESSION_PORT=47400
# pairing, open only while a pairing window is
PAIRING_PORT=47401
HEALTH_PORT=47480
# 127.0.0.1 only; in lan mode that is the loopback of the node
ADMIN_PORT=47403

# ---- LAN discovery ----------------------------------------------------------------------------------------------------
# lan (the default): host network on the node of worker.lan, namespace "privileged" with "restricted" as warn and audit
# level (gucef_service/README.md, "LAN discovery")
DISCOVERY_MODE=lan
DISCOVERY_NODE_NAME=worker-x299
DISCOVERY_PORT=47800

# ---- storage ----------------------------------------------------------------------------------------------------------
# the library (packs, conversions), staging of uploads, journals, the credential store and its key
DATA_SIZE=500Gi
# auto: the first of raid, mirror, jbod, local-path the cluster has (Longhorn-managed first: longhorn-raid before raid)
STORAGE_CLASS=auto
# /tmp of the pod (HOME and the cache directory of the image): room for the temporary files of a conversion
TMP_SIZE=2Gi

# ---- placement and resources ------------------------------------------------------------------------------------------
# the label of the node that holds the imported image; once, before the first deploy:
#   kubectl label node worker-x299 gucef-service-host=true
NODE_SELECTOR_KEY=gucef-service-host
NODE_SELECTOR_VALUE="true"
CPU_REQUEST=250m
# A pack conversion (the converter hook: import, intermediate, glTF writer) holds a whole model set in memory, so the
# limit is well above the idle use. Keep "memorySoftLimitMB" of the site settings (Service) below MEMORY_LIMIT: above
# it the service logs a warning before the kubelet kills the container at the limit. Fewer conversion threads
# ("threads" of ConverterHook in the site settings) need less.
MEMORY_REQUEST=1Gi
MEMORY_LIMIT=6Gi

# ---- lifecycle --------------------------------------------------------------------------------------------------------
# "drainSeconds" of the site settings (Service); the program's default is 20 as well
DRAIN_SECONDS=20
# drain + closing the store, the host and the database connection + margin
TERMINATION_GRACE_SECONDS=45
# 10 s x 30: the catalogue migrations of a first start against PostgreSQL
STARTUP_FAILURE_THRESHOLD=30

# ---- configuration ----------------------------------------------------------------------------------------------------
SITE_CONFIG_NAME=AssetStoreService.json
SITE_CONFIG_SOURCE=AssetStoreService_site.json
CONTAINER_ARGS="--console --data-dir /data --config /opt/assetstore/config/site/AssetStoreService.json"

# ---- the database password as a file (components/secret-file) --------------------------------------------------------
# "passwordFile" of the Database section of the site settings is SECRET_FILE_MOUNT_DIR/SECRET_FILE_KEY. The Secret is
# created by a separate step (README.md); deploy.sh refuses the rollout while it is missing
SECRET_FILE_SECRET_NAME=assetstore-db
SECRET_FILE_KEY=password
SECRET_FILE_MOUNT_DIR=/secrets/assetstore-db
SECRET_FILE_MODE=0400

# ---- credentials key (components/credentials-key) ---------------------------------------------------------------------
# not used: the credential store of the service keeps its key in /data/credentials on the claim (made at the first
# start), so CREDENTIALS_SECRET_NAME stays empty and the component is not rendered
CREDENTIALS_SECRET_NAME=""
