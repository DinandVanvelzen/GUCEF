# Packages of the modules FreeImage depends on
set( MODULE_DEPENDENCIES gucefHeaders )
if ( LINUX32 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( LINUX32 )
if ( LINUX64 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( LINUX64 )
if ( WIN32 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( WIN32 )
if ( WIN64 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( WIN64 )

# The minimum C++ standard of FreeImage and the modules it depends on
if ( LINUX32 )
  set( MODULE_MIN_CPP_STANDARD 14 )
endif( LINUX32 )
if ( LINUX64 )
  set( MODULE_MIN_CPP_STANDARD 14 )
endif( LINUX64 )
if ( WIN32 )
  set( MODULE_MIN_CPP_STANDARD 14 )
endif( WIN32 )
if ( WIN64 )
  set( MODULE_MIN_CPP_STANDARD 14 )
endif( WIN64 )
GUCEF_check_min_cpp_standard( FreeImage "${MODULE_MIN_CPP_STANDARD}" )

list( REMOVE_DUPLICATES MODULE_DEPENDENCIES )
foreach( MODULE_DEPENDENCY ${MODULE_DEPENDENCIES} )
  find_package( ${MODULE_DEPENDENCY} CONFIG REQUIRED )
endforeach()

# The module itself
add_subdirectory( "${GUCEF_SOURCE_DIR}/dependencies/FreeImage" "${CMAKE_BINARY_DIR}/FreeImage" )
if ( NOT TARGET FreeImage )
  message( FATAL_ERROR "Module FreeImage is not available for target platform ${GUCEF_TARGET_PLATFORM}" )
endif()
target_link_libraries( FreeImage PUBLIC gucefHeaders )

# The package of the module, for building dependents against it
GUCEF_install_module_package( FreeImage DEPENDENCIES ${MODULE_DEPENDENCIES} )
