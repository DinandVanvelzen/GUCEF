# Packages of the modules assimp depends on
set( MODULE_DEPENDENCIES assimp.Includes gucefHeaders pugixml )
if ( EMSCRIPTEN32 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( EMSCRIPTEN32 )
if ( EMSCRIPTEN64 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( EMSCRIPTEN64 )
if ( LINUX32 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( LINUX32 )
if ( LINUX64 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( LINUX64 )
if ( WIN32 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( WIN32 )
if ( WIN64 )
  list( APPEND MODULE_DEPENDENCIES zlib )
endif( WIN64 )

# The minimum C++ standard of assimp and the modules it depends on
set( MODULE_MIN_CPP_STANDARD 17 )
GUCEF_check_min_cpp_standard( assimp "${MODULE_MIN_CPP_STANDARD}" )

list( REMOVE_DUPLICATES MODULE_DEPENDENCIES )
foreach( MODULE_DEPENDENCY ${MODULE_DEPENDENCIES} )
  find_package( ${MODULE_DEPENDENCY} CONFIG REQUIRED )
endforeach()

# The module itself
add_subdirectory( "${GUCEF_SOURCE_DIR}/dependencies/assimp" "${CMAKE_BINARY_DIR}/assimp" )
if ( NOT TARGET assimp )
  message( FATAL_ERROR "Module assimp is not available for target platform ${GUCEF_TARGET_PLATFORM}" )
endif()
target_link_libraries( assimp PUBLIC gucefHeaders )

# The package of the module, for building dependents against it
GUCEF_install_module_package( assimp DEPENDENCIES ${MODULE_DEPENDENCIES} )
