# Packages of the modules glslang depends on
set( MODULE_DEPENDENCIES gucefHeaders )

# The minimum C++ standard of glslang and the modules it depends on
if ( ANDROID32 )
  set( MODULE_MIN_CPP_STANDARD 17 )
endif( ANDROID32 )
if ( ANDROID64 )
  set( MODULE_MIN_CPP_STANDARD 17 )
endif( ANDROID64 )
if ( LINUX32 )
  set( MODULE_MIN_CPP_STANDARD 17 )
endif( LINUX32 )
if ( LINUX64 )
  set( MODULE_MIN_CPP_STANDARD 17 )
endif( LINUX64 )
if ( WIN32 )
  set( MODULE_MIN_CPP_STANDARD 17 )
endif( WIN32 )
if ( WIN64 )
  set( MODULE_MIN_CPP_STANDARD 17 )
endif( WIN64 )
GUCEF_check_min_cpp_standard( glslang "${MODULE_MIN_CPP_STANDARD}" )

list( REMOVE_DUPLICATES MODULE_DEPENDENCIES )
foreach( MODULE_DEPENDENCY ${MODULE_DEPENDENCIES} )
  find_package( ${MODULE_DEPENDENCY} CONFIG REQUIRED )
endforeach()

# The module itself
add_subdirectory( "${GUCEF_SOURCE_DIR}/dependencies/glslang" "${CMAKE_BINARY_DIR}/glslang" )
if ( NOT TARGET glslang )
  message( FATAL_ERROR "Module glslang is not available for target platform ${GUCEF_TARGET_PLATFORM}" )
endif()
target_link_libraries( glslang PUBLIC gucefHeaders )

# The package of the module, for building dependents against it
GUCEF_install_module_package( glslang DEPENDENCIES ${MODULE_DEPENDENCIES} )
